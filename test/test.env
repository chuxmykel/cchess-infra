# The local test stack's .env - throwaway values, never a real server's.
DOMAIN=localhost
CADDY_TLS=internal
DB_USERNAME=cchess
DB_NAME=cchess
DB_PASSWORD=local-test-only
JWT_ACCESS_SECRET=local-test-only-access
