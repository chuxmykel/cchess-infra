# The e2e stack's .env (compose.e2e.yaml) - throwaway values, never a real
# server's.
DOMAIN=localhost
CADDY_TLS=internal
DB_USERNAME=cchess
DB_NAME=cchess
DB_PASSWORD=e2e-only
JWT_ACCESS_SECRET=e2e-only-access
JWT_REFRESH_SECRET=e2e-only-refresh
# No lichess token: the opening explorer answers from the games here.
EXPLORER_MAINTENANCE=false
BACKUP_HOUR=3
BACKUP_KEEP=3
