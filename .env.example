# Copy with scripts/gen-secrets.sh, which fills in the secrets. Compose
# reads this for compose.yaml's ${...}, and the api gets all of it as its
# environment (cchess-be's own .env.example says what each app var does).
#
# Leave an optional var commented out rather than blank: the api reads a
# blank one as set to "", not as unset (PORT= would be port 0).

# The API's public hostname, its DNS A/AAAA record pointing at this box.
# Caddy gets its certificate from Let's Encrypt on first start.
DOMAIN=api.example.com
# An email address for the Let's Encrypt account (its notices), or
# "internal" for Caddy's own CA - only for testing, as clients won't trust it.
CADDY_TLS=you@example.com

# Postgres - the database container is created with these.
DB_USERNAME=cchess
DB_NAME=cchess
DB_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL_DAYS=30

# Where the api is reached from outside: the links in its emails and pages.
PUBLIC_URL=https://api.example.com
NODE_ENV=production
# Caddy is the only proxy in front of the api, on Docker's private network:
# believe X-Forwarded-For from there, so rate limits see players' addresses.
TRUST_PROXY=loopback, uniquelocal

# Email, through Resend (https://resend.com): without a key, email is only
# logged. The sender's domain has to be verified in Resend - its SPF, DKIM
# and DMARC records in the domain's DNS.
RESEND_API_KEY=
MAIL_FROM=cchess <no-reply@mail.example.com>
# Reports go here, and the app and pages show it.
SUPPORT_EMAIL=support@example.com

# The app: the oldest version still supported (older ones are asked to
# update), and what lets it open the api's email links itself - Apple's
# team ID, and the SHA-256 fingerprints of the Android signing keys (Play
# Console > App integrity), comma-separated.
MIN_APP_VERSION=1.0.0
# APPLE_TEAM_ID=
# ANDROID_CERT_SHA256=

# The house bots (compose.yaml's housebots): COMPOSE_PROFILES=bots starts
# them. Each username:time:mode in HOUSE_BOTS is an account made beforehand
# (README, "House bots"), signing in with HOUSE_BOT_PASSWORD.
# COMPOSE_PROFILES=bots
# HOUSE_BOTS=housebot_blitz:5+0:rated,housebot_guests:5+0:casual
# HOUSE_BOT_PASSWORD=
# HOUSE_BOT_LEVEL=medium

# LICHESS_TOKEN=
# LOG_LEVEL=log
# CORS_ORIGIN=*

# Multi-process sharding: needs the redis service too (README).
# CLUSTER_WORKERS=4
# REDIS_HOST=redis
# REDIS_PORT=6379

# Backups: daily at this hour (UTC), keeping this many on the box.
BACKUP_HOUR=3
BACKUP_KEEP=7
# The day of the month the newest backup is test-restored, after that day's
# backup (backup/restore-drill.sh); empty for never.
RESTORE_DRILL_DAY=1
# Off-site copies, through an rclone remote defined here by environment
# variables (https://rclone.org/docs/#config-file). For example, a
# Cloudflare R2 or Backblaze B2 bucket, S3-style:
# RCLONE_REMOTE=offsite:cchess-backups
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
